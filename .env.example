# OpenRouteService (route map). Self-hosted instance needs no key.
NEXT_PUBLIC_ORS_BASE_URL=https://ors.transportbeat.nl/ors
NEXT_PUBLIC_ORS_API_KEY=

# Optional: CARTO basemap key (free, request at https://carto.com/basemaps/apikey).
# Without it the maps use desaturated OpenStreetMap tiles instead of CARTO "light".
NEXT_PUBLIC_CARTO_API_KEY=

# Shared demo login — one generic account for everyone. Required: without
# these the app cannot be logged into.
DEMO_USERNAME=
DEMO_PASSWORD=
# Optional: secret for signing session cookies (e.g. `openssl rand -hex 32`).
# If unset it is derived from the credentials, so changing the password logs everyone out.
AUTH_SECRET=

# Optional: where the demo dataset lives on the server
# (default: ./demo-data/utrecht, filled by scripts/prepare-demo-data.sh)
DEMO_DATA_DIR=
