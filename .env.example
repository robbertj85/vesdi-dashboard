# OpenRouteService (route map). Self-hosted instance needs no key.
NEXT_PUBLIC_ORS_BASE_URL=https://ors.transportbeat.nl/ors
NEXT_PUBLIC_ORS_API_KEY=

# Optional: CARTO basemap key (free, request at https://carto.com/basemaps/apikey).
# Without it the maps use desaturated OpenStreetMap tiles instead of CARTO "light".
NEXT_PUBLIC_CARTO_API_KEY=

# Shared demo login — one generic account for everyone. Required: without
# these the app cannot be logged into.
DEMO_USERNAME=
DEMO_PASSWORD=
# Optional: secret for signing session cookies (e.g. `openssl rand -hex 32`).
# If unset it is derived from the credentials, so changing the password logs everyone out.
AUTH_SECRET=

# Optional: where the demo dataset lives on the server
# (default: ./demo-data/utrecht, filled by scripts/prepare-demo-data.sh)
DEMO_DATA_DIR=

# Enquête (questionnaire): key for the results page / invite management
# (e.g. `openssl rand -hex 16`). Without it the results cannot be viewed.
SURVEY_ADMIN_KEY=
# Optional: where responses.jsonl and invites.json are stored. Must be
# persistent storage (e.g. a Docker volume); default ./data/survey
SURVEY_DATA_DIR=

# Optional: where precomputed route-map trajectories are stored (default ./data/routes).
# Fill it with `npm run routes:precompute`; must be persistent storage on a server.
ROUTE_CACHE_DIR=

# Public address of the site, used in personal invite links (e.g. https://prototype.transportlab.app/vesdi).
# Defaults to the address the admin page is opened on.
PUBLIC_BASE_URL=
# Optional: location of the recipient list (CSV: naam;gemeente;email). Default ./data/survey/ontvangers.csv
SURVEY_RECIPIENTS_FILE=
